<FindBugsFilter>

  <!-- General stuff we don't care about -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,ICAST_QUESTIONABLE_UNSIGNED_RIGHT_SHIFT,CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Convenience catch for a variety of exceptions -->
  <Match>
    <Class name="com.healthmarketscience.jackcess.DataType"/>
    <Method name="addNewSqlType"/>
    <Bug pattern="REC_CATCH_EXCEPTION,DE_MIGHT_IGNORE"/>
  </Match>

  <!-- Streams kept open on purpose -->
  <Match>
    <Class name="com.healthmarketscience.jackcess.util.OleBlob$Builder"/>
    <Bug pattern="OBL_UNSATISFIED_OBLIGATION"/>
  </Match>

  <!-- Intentional: the default function classes register into DefaultFunctions
       during initialization, forming a benign init cycle -->
  <Match>
    <Class name="~com\.healthmarketscience\.jackcess\.impl\.expr\.Default.*Functions"/>
    <Bug pattern="IC_INIT_CIRCULARITY"/>
  </Match>

  <!-- Intentional comparisons -->
  <Match>
    <Class name="com.healthmarketscience.jackcess.impl.TableImpl"/>
    <Or>
      <Method name="findIndexForColumns"/>
      <Method name="getInputAutoNumberRowValue"/>
      <Method name="updateRow"/>
    </Or>
    <Bug pattern="ES_COMPARING_STRINGS_WITH_EQ"/>
  </Match>

  <!-- Legit logic -->
  <Match>
    <Class name="com.healthmarketscience.jackcess.impl.expr.DefaultFinancialFunctions"/>
    <Method name="calculateRate"/>
    <Bug pattern="FL_FLOATS_AS_LOOP_COUNTERS"/>
  </Match>

  <!-- Only need equals -->
  <Match>
    <Or>
      <Class name="com.healthmarketscience.jackcess.impl.IndexData$NodeEntry"/>
      <Class name="com.healthmarketscience.jackcess.impl.complex.ComplexValueForeignKeyImpl"/>
    </Or>
    <Bug pattern="HE_EQUALS_NO_HASHCODE"/>
  </Match>

  <!-- Safety catch for adding rows -->
  <Match>
    <Class name="com.healthmarketscience.jackcess.impl.TableImpl"/>
    <Method name="addRows"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>
  
  <!-- Internal use class -->
  <Match>
    <Class name="com.healthmarketscience.jackcess.impl.query.QueryImpl$AppendableList"/>
    <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
  </Match>
  
</FindBugsFilter>
